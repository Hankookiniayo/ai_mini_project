# ── LangSmith 추적 ─────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=shop-cs-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── LLM ────────────────────────────────────────────────────────
# fake | ollama | openai | hybrid  (hybrid: 가벼운 대화=Ollama, 라우팅·계획·답변 작성=OpenAI)
# LLM_BACKEND=hybrid
OPENAI_API_KEY=sk-...
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o
# OLLAMA_CHAT_MODEL=qwen3:8b

# ── MCP 연결 ───────────────────────────────────────────────────
# stdio(server.py가 MCP를 서브프로세스로 띄움) | http(sh/run_mcp.sh로 띄운 별도 서비스)
# MCP_TRANSPORT=http
# MCP_OPS_URL=http://127.0.0.1:8200/mcp

# ── 정책 문서 검색 (MCP 서버 쪽, sh/run_mcp.sh가 자동 감지 — 직접 지정하면 우선) ──
# POLICY_SEARCH=hybrid               # hybrid(벡터+키워드) | qdrant(벡터만) | keyword
# QDRANT_PATH=./qdrant_local         # Docker 없이 로컬 파일 모드 (sh/index_policies.sh가 만듦)
# QDRANT_URL=http://127.0.0.1:6333   # Qdrant 서버를 따로 띄웠을 때만
# EMBEDDING_BACKEND=openai           # openai | fake(테스트용)
# EMBEDDING_MODEL=text-embedding-3-large   # 바꾸면 sh/index_policies.sh로 다시 인덱싱

# ── 쇼핑몰 주문 데이터 (server.py · MCP 서버 공통) ──────────────────
# SHOP_BACKEND=sqlite                # sqlite(기본, 처음 실행 시 data/shop/*.json으로 자동 시드) | json(파일 직접 읽기)
# SHOP_DB_PATH=./shop.db             # 다시 만들기: python scripts/seed_shop_db.py --reset

# ── 에이전트 튜닝 ───────────────────────────────────────────────
# POLICY_MIN_SCORE_HYBRID=0.15       # 하이브리드 점수 임계치 (미달이면 질의를 바꿔 재검색)
# POLICY_HYBRID_WEIGHT=0.5           # 하이브리드에서 벡터 점수의 비중
# POLICY_MIN_SCORE=0.26              # 벡터만 쓸 때(qdrant) 임계치
# POLICY_SECOND_RATIO=0.9            # 2등 문서를 함께 가져올 최소 비율 (1등 점수 대비)
# POLICY_MIN_SCORE_KEYWORD=0.3       # 키워드 검색 임계치
# VALIDATION_MODE=rules              # rules(형식+수치+주문번호+날짜+누락) | basic(형식만, Before 비교용)
